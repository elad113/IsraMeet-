# Set VITE_API_BASE_URL to the HTTPS URL where this repository's Vercel functions are deployed.
# Example: VITE_API_BASE_URL=https://your-project.vercel.app
# Keep AI keys server-side in Vercel Project Settings > Environment Variables:
# GROQ_API_KEY=...
# GEMINI_API_KEY=...
# Cloud sync (optional; requires running database/supabase-schema.sql first):
# SUPABASE_URL=...
# SUPABASE_SERVICE_ROLE_KEY=...
# Never put secret keys in VITE_* variables; VITE_* values are embedded in the client app.
