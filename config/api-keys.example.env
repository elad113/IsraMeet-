# CodeQuest AI provider configuration template
# Groq is the PRIMARY provider. Gemini is used only as FALLBACK.
#
# Copy this file to api-keys.env for local builds, fill in your keys, and NEVER commit api-keys.env.
# For GitHub Actions builds, add these values under:
# Repository Settings -> Secrets and variables -> Actions -> New repository secret
#
# Required secret names:
GROQ_API_KEY=PASTE_YOUR_GROQ_CLOUD_API_KEY_HERE
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Provider order (keep these values):
AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini
